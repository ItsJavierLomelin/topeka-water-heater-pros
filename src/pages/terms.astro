---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import Sections from '~/components/Sections.astro';
import { C } from '~/data/city';
const page = C.terms;
---

<BaseLayout title={page.title} description={page.desc} path="/terms/" crumbs={[{ name: 'Terms', path: '/terms/' }]}>
  <PageHero h1={page.h1} intro={page.intro} formLocation="Terms" />
  <Sections blocks={page.sections} />
</BaseLayout>
