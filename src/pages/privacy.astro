---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import Sections from '~/components/Sections.astro';
import { C } from '~/data/city';
const page = C.privacy;
---

<BaseLayout title={page.title} description={page.desc} path="/privacy/" crumbs={[{ name: 'Privacy', path: '/privacy/' }]}>
  <PageHero h1={page.h1} intro={page.intro} formLocation="Privacy" />
  <Sections blocks={page.sections} />
</BaseLayout>
